{
  "name": "maj-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:app": "eslint . --max-warnings 0",
    "lint:deno": "deno lint --quiet supabase/functions/",
    "lint": "npm run lint:app && npm run lint:deno",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:deno": "deno check --quiet --config supabase/deno.json supabase/functions/**/*.ts",
    "typecheck": "npm run typecheck:app && npm run typecheck:deno",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.9",
    "@vercel/analytics": "^1.6.1",
    "plotly.js": "^2.27.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.10.6",
    "@types/plotly.js": "^2.35.13",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/react-plotly.js": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "supabase": "^2.67.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.0.10"
  }
}
